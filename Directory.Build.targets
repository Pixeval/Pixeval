<Project>
    <!-- Runtime Async requires .NET 11 and a CoreCLR or NativeAOT host. -->
    <PropertyGroup Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0')) and '$(EnableRuntimeAsync)' != 'false'">
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <!-- SDK-created transitive references must use the same host settings as direct references. -->
    <ItemDefinitionGroup Condition="'$(EnableRuntimeAsync)' == 'false'">
        <ProjectReference>
            <AdditionalProperties>EnableMcp=$(EnableMcp);EnableRuntimeAsync=$(EnableRuntimeAsync)</AdditionalProperties>
        </ProjectReference>
    </ItemDefinitionGroup>

  <!-- Consume unpublished Material dependencies from pinned submodules without
       modifying their upstream project files or requiring GitHub Packages credentials. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Material3Expressive'">
    <PackageReference Remove="Shirasagi0012.MaterialColorUtilities;Shirasagi0012.MaterialSymbols.Avalonia.Rounded" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/lib/MaterialColorUtilities/MaterialColorUtilities/MaterialColorUtilities.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/lib/MaterialSymbols/MaterialSymbols.Avalonia.Rounded/MaterialSymbols.Avalonia.Rounded.csproj" />
  </ItemGroup>

  <!-- Build centrally managed submodules against Pixeval's rendering stack. -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageVersion Update="Shirasagi0012.SmoothScroll.Avalonia" Version="12.0.0.1" />
    <PackageVersion Update="Avalonia;Avalonia.Desktop;Avalonia.Skia;Avalonia.Themes.Fluent;Avalonia.Fonts.Inter;Avalonia.Headless;Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Update="SkiaSharp;SkiaSharp.NativeAssets.Win32;SkiaSharp.NativeAssets.macOS;SkiaSharp.NativeAssets.Linux;SkiaSharp.NativeAssets.WebAssembly" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ComposeAnimation.Runtime' Or '$(MSBuildProjectName)' == 'ComposeAnimation.Avalonia'">
    <PackageReference Update="Avalonia" Version="12.1.6" />
  </ItemGroup>
</Project>
