<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--  Duplication from HighContrast colors to match keys, set to magenta to show these should not be used  -->
            <SolidColorBrush x:Key="SystemColorWindowTextColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorWindowColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorButtonFaceColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorButtonTextColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorHighlightColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorHighlightTextColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorHotlightColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorGrayTextColorBrush" Color="#FF00FF" />

            <LinearGradientBrush x:Key="ControlElevationBorderBrush" TransformOrigin="50%,50%" StartPoint="0,0" EndPoint="0,3">
                <LinearGradientBrush.Transform>
                    <ScaleTransform ScaleY="-1" />
                </LinearGradientBrush.Transform>
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorSecondary}" />
                    <GradientStop Offset="1" Color="{StaticResource ControlStrokeColorDefault}" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CircleElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.50" Color="{StaticResource ControlStrokeColorDefault}" />
                    <GradientStop Offset="0.70" Color="{StaticResource ControlStrokeColorSecondary}" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentControlElevationBorderBrush" TransformOrigin="50%,50%" StartPoint="0,0" EndPoint="0,3">
                <LinearGradientBrush.Transform>
                    <ScaleTransform ScaleY="-1" />
                </LinearGradientBrush.Transform>
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorOnAccentSecondary}" />
                    <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorOnAccentDefault}" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <SolidColorBrush
                x:Key="SystemControlHighlightListAccentVeryHighBrush"
                Opacity="0.9"
                Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush
                x:Key="SystemControlHighlightListAccentMediumLowBrush"
                Opacity="0.75"
                Color="{DynamicResource SystemAccentColor}" />
            <x:Boolean x:Key="UseSystemFocusVisuals">True</x:Boolean>
            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,2</Thickness>
            <StaticResource x:Key="DefaultTextForegroundThemeBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="FocusStrokeColorOuterBrush" />
            <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="FocusStrokeColorInnerBrush" />

            <!--  Based on AcrylicBrush_19h1_DynamicResources.xaml, Fallback Colors  -->
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="AccentAcrylicInAppFillColorBaseBrush" Color="{DynamicResource SystemAccentColorLight3}" />

            <SolidColorBrush x:Key="PixevalTranslucentBackground" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="ViewerDockedPaneBackgroundBrush" Color="#EEFFFFFF" />
            <SolidColorBrush x:Key="PixivLogo" Color="#0096FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!--  Duplication from HighContrast colors to match keys, set to magenta to show these should not be used  -->
            <SolidColorBrush x:Key="SystemColorWindowTextColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorWindowColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorButtonFaceColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorButtonTextColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorHighlightColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorHighlightTextColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorHotlightColorBrush" Color="#FF00FF" />
            <SolidColorBrush x:Key="SystemColorGrayTextColorBrush" Color="#FF00FF" />

            <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,3">
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorSecondary}" />
                    <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorDefault}" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CircleElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.70" Color="{StaticResource ControlStrokeColorSecondary}" />
                    <GradientStop Offset="0.50" Color="{StaticResource ControlStrokeColorDefault}" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,3">
                <LinearGradientBrush.Transform>
                    <ScaleTransform ScaleY="-1" />
                </LinearGradientBrush.Transform>
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorOnAccentSecondary}" />
                    <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorOnAccentDefault}" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <SolidColorBrush
                x:Key="SystemControlHighlightListAccentVeryHighBrush"
                Opacity="0.9"
                Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush
                x:Key="SystemControlHighlightListAccentMediumLowBrush"
                Opacity="0.75"
                Color="{DynamicResource SystemAccentColor}" />
            <x:Boolean x:Key="UseSystemFocusVisuals">True</x:Boolean>
            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,2</Thickness>
            <StaticResource x:Key="DefaultTextForegroundThemeBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="FocusStrokeColorOuterBrush" />
            <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="FocusStrokeColorInnerBrush" />

            <!--  Based on AcrylicBrush_19h1_themeresources.xaml, Fallback Colors  -->
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#202020" />
            <SolidColorBrush x:Key="AccentAcrylicInAppFillColorBaseBrush" Color="{DynamicResource SystemControlAccentColorDark2}" />

            <SolidColorBrush x:Key="PixevalTranslucentBackground" Color="#8F000000" />
            <SolidColorBrush x:Key="ViewerDockedPaneBackgroundBrush" Color="#EE1E1E1E" />
            <SolidColorBrush x:Key="PixivLogo" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:String x:Key="ChevronDownGlyph">&#xE70D;</x:String>
    <x:String x:Key="ChevronUpGlyph">&#xE70E;</x:String>

    <Thickness x:Key="HelperButtonThemePadding">0,0,-2,0</Thickness>

    <!--  Shared Menu items  -->
    <Thickness x:Key="MenuBarItemButtonPadding">10,4,10,4</Thickness>
    <x:Double x:Key="MenuFlyoutSeparatorHeight">1</x:Double>
    <Thickness x:Key="MenuFlyoutItemChevronMargin">24,0,0,0</Thickness>

    <!--  Flyouts  -->
    <Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
    <Thickness x:Key="MenuFlyoutScrollerMargin">0,4,0,4</Thickness>

</ResourceDictionary>
