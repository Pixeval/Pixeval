<Application
    x:Class="Pixeval.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:autoSettingsPage="using:AutoSettingsPage.Avalonia"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:smoothScroll="using:SmoothScroll.Avalonia.Controls"
    xmlns:tabView="using:TabView.Avalonia">

    <Application.Styles>
        <Fluent2Theme />
        <tabView:TabsViewFluent2Theme />
        <!--  Register text themes before loading styles that reference them through StaticResource.  -->
        <Styles>
            <Styles.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="Themes/TextBlockStyles.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Styles.Resources>
        </Styles>
        <autoSettingsPage:AutoSettingsPageTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent2.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        </Style>
        <Style Selector="edit|TextEditor">
            <Setter Property="FontFamily" Value="{DynamicResource PixevalMonospaceFontFamily}" />
        </Style>
        <Style Selector="Window.mica">
            <Setter Property="TransparencyLevelHint" Value="Mica,None" />
        </Style>
        <Style Selector="Window.mica[ActualTransparencyLevel=Mica]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowDecorationsTheme" Value="{DynamicResource MicaWindowDrawnDecorationsTheme}" />
        </Style>
        <StyleInclude Source="/Controls/FloatingCommandBarStyles.axaml" />
        <StyleInclude Source="/Controls/CommandBarStyles.axaml" />
        <smoothScroll:ScrollViewDefaultTheme />
        <smoothScroll:ScrollViewerSmoothTheme />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <x:Double x:Key="SmallIconFontSize">16</x:Double>
            <FontFamily x:Key="ContentControlThemeFontFamily">$Default</FontFamily>
            <FontFamily x:Key="PixevalMonospaceFontFamily">Cascadia Code,Cascadia Mono,SF Mono,Menlo,Monaco,Consolas,Liberation Mono,DejaVu Sans Mono,monospace</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="Themes/Brushes.axaml" />
                <MergeResourceInclude Source="Themes/Controls.axaml" />
                <MergeResourceInclude Source="Themes/WindowDrawnDecorations.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
