<ContentPage
    x:Class="Pixeval.Views.Settings.SettingsMainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appManagement="using:Pixeval.AppManagement"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Pixeval.Models.Extensions"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoSettingsPage.Models"
    xmlns:pixeval="using:Pixeval"
    xmlns:pixevalControls="using:Pixeval.Controls"
    xmlns:utilities="using:Pixeval.Utilities"
    xmlns:viewModels="using:Pixeval.ViewModels"
    x:DataType="{x:Type viewModels:SettingsPageViewModel}"
    Header="{I18N {x:Static pixeval:MainPageResources+Tab.Settings}}"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="20">
            <controls:SettingsExpander HeaderIcon="{markup:SymbolIcon ArrowSync}">
                <controls:SettingsExpander.Header>
                    <HyperlinkButton
                        Padding="0"
                        Click="ReleaseNotesHyperlink_OnClicked"
                        Content="{Binding CurrentVersion, Mode=OneTime}" />
                </controls:SettingsExpander.Header>
                <controls:SettingsExpander.Description>
                    <StackPanel Spacing="3">
                        <TextBlock>
                            <Run Text="{I18N {x:Static pixeval:SettingsMainViewResources.LastCheckedPrefix}}" />
                            <Run Text="{Binding LastCheckedUpdate}" />
                        </TextBlock>
                    </StackPanel>
                </controls:SettingsExpander.Description>
                <controls:SettingsExpander.Content>
                    <Button Click="CheckForUpdateButton_OnClicked" Content="{I18N {x:Static pixeval:SettingsMainViewResources+CheckForUpdatesButton.Content}}" />
                </controls:SettingsExpander.Content>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenTempEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenTempEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderLightning}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.TempFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="ms-windows-store://pdp/?ProductId=9P1RZL9Z8454"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+MsStoreCheckForUpdatesEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon StoreMicrosoft}"
                        IsClickEnabled="True"
                        Tag="ms-windows-store://pdp/?ProductId=9P1RZL9Z8454" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="https://github.com/Pixeval/Pixeval/releases"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+GitHubCheckForUpdatesEntry.Header}}"
                        IsClickEnabled="True"
                        Tag="https://github.com/Pixeval/Pixeval/releases">
                        <controls:SettingsCard.HeaderIcon>
                            <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.GitHub}}" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <pixevalControls:InfoBar
                x:Name="UpdateStatusInfoBar"
                Mode="Info"
                Text="{I18N {x:Static pixeval:SettingsMainViewResources+UpdateAvailable.Unknown}}" />

            <controls:SettingsExpander
                Description="{I18N {x:Static pixeval:SettingsMainViewResources+BugReportEntry.Description}}"
                Header="{I18N {x:Static pixeval:SettingsMainViewResources+BugReportEntry.Header}}"
                HeaderIcon="{markup:SymbolIcon Bug}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+BugReportChannelsEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+BugReportChannelsEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon Send}">
                        <CommandBar
                            Background="Transparent"
                            DefaultLabelPosition="Collapsed"
                            IsDynamicOverflowEnabled="True">
                            <CommandBarButton
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Tag="https://github.com/Pixeval/Pixeval/issues/new/choose"
                                ToolTip.Tip="{I18N {x:Static pixeval:SettingsMainViewResources+GitHubBugReportEntry.ToolTip}}">
                                <CommandBarButton.Icon>
                                    <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.GitHub}}" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Icon="{markup:SymbolIcon Mail}"
                                Tag="mailto:poker_sang@outlook.com"
                                ToolTip.Tip="{I18N {x:Static pixeval:SettingsMainViewResources+EMailBugReportEntry.ToolTip}}" />
                            <CommandBarButton
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Tag="https://jq.qq.com/?_wv=1027&amp;k=trDeCrog"
                                ToolTip.Tip="{I18N {x:Static pixeval:SettingsMainViewResources+QQBugReportEntry.ToolTip}}">
                                <CommandBarButton.Icon>
                                    <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.QQ}}" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                        </CommandBar>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenLogEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenLogEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderList}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.LogsFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenTempEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenTempEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderLightning}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.TempFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenLocalEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenLocalEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderBriefcase}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.ApplicationFolderPath}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenExtensionsEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenExtensionsEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderAdd}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.ExtensionsFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenSettingsEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenSettingsEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderPerson}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.SettingsFolder}" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon Open}"
                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                Description="{I18N {x:Static pixeval:SettingsMainViewResources+RateEntry.Description}}"
                Header="{I18N {x:Static pixeval:SettingsMainViewResources+RateEntry.Header}}"
                HeaderIcon="{markup:SymbolIcon Star}"
                IsClickEnabled="True"
                Tag="ms-windows-store://pdp/?ProductId=9P1RZL9Z8454" />

            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                Click="SwitchAccountButton_OnClicked"
                Description="{I18N {x:Static pixeval:SettingsMainViewResources+SwitchAccountEntry.Description}}"
                Header="{I18N {x:Static pixeval:SettingsMainViewResources+SwitchAccountEntry.Header}}"
                HeaderIcon="{markup:SymbolIcon PersonSwap}"
                IsClickEnabled="True" />

            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ArrowReset}"
                Click="ResetDefaultSettings_OnClicked"
                Description="{I18N {x:Static pixeval:SettingsMainViewResources+ResetDefaultSettingsEntry.Description}}"
                Header="{I18N {x:Static pixeval:SettingsMainViewResources+ResetDefaultSettingsEntry.Header}}"
                HeaderIcon="{markup:SymbolIcon Apps}"
                IsClickEnabled="True" />

            <controls:SettingsExpander
                Description="{I18N {x:Static pixeval:SettingsMainViewResources+BackupSettingsEntry.Description}}"
                Header="{I18N {x:Static pixeval:SettingsMainViewResources+BackupSettingsEntry.Header}}"
                HeaderIcon="{markup:SymbolIcon ClipboardSettings}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+OpenSettingsEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+OpenSettingsEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon FolderPerson}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.SettingsFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="ExportSettingsPlainText_OnClicked"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+ExportSettingsPlaintextEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+ExportSettingsPlaintextEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon ArrowExport}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="ImportSettingsPlaintext_OnClicked"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+ImportSettingsPlaintextEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+ImportSettingsPlaintextEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon ArrowImport}"
                        IsClickEnabled="True" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteHistoriesEntry.Header}}" HeaderIcon="{markup:SymbolIcon HistoryDismiss}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="DeleteFileCacheEntryButton_OnClicked"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteFileCacheEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteFileCacheEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="DeleteSearchHistoriesButton_OnClicked"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteSearchHistoriesEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteSearchHistoriesEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="DeleteBrowseHistoriesButton_OnClicked"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteBrowseHistoriesEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteBrowseHistoriesEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="DeleteDownloadHistoriesButton_OnClicked"
                        Description="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteDownloadHistoriesEntry.Description}}"
                        Header="{I18N {x:Static pixeval:SettingsMainViewResources+DeleteDownloadHistoriesEntry.Header}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                Click="AboutPageButton_OnClicked"
                Header="{I18N {x:Static pixeval:MainPageResources+Tab.About}}"
                HeaderIcon="{markup:SymbolIcon PersonStarburst,
                                               IconVariant=Color}"
                IsClickEnabled="True" />
            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                Click="HelpPageButton_OnClicked"
                Header="{I18N {x:Static pixeval:MainPageResources+Tab.Help}}"
                HeaderIcon="{markup:SymbolIcon ChatBubblesQuestion,
                                               IconVariant=Color}"
                IsClickEnabled="True" />
            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                Click="NavigationSettingsButton_OnClicked"
                Header="{I18N {x:Static pixeval:MainPageResources+Tab.NavigationSettings}}"
                HeaderIcon="{markup:SymbolIcon LocationRipple,
                                               IconVariant=Color}"
                IsClickEnabled="True" />
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="{x:Type extensions:ExtensionSettingsGroup}">
                        <controls:SettingsCard
                            ActionIcon="{markup:SymbolIcon ChevronRight}"
                            Click="SettingsCard_OnClick"
                            Description="{Binding Description}"
                            Header="{Binding Header}"
                            HeaderIcon="{Binding Icon}"
                            IsClickEnabled="True" />
                    </DataTemplate>
                    <DataTemplate x:DataType="{x:Type models:ISettingsGroup}">
                        <controls:SettingsCard
                            ActionIcon="{markup:SymbolIcon ChevronRight}"
                            Click="SettingsCard_OnClick"
                            Description="{Binding Description}"
                            Header="{Binding Header}"
                            IsClickEnabled="True">
                            <controls:SettingsCard.HeaderIcon>
                                <fluent:SymbolIcon IconVariant="Color" Symbol="{Binding Icon}" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
