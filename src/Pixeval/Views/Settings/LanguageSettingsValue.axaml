<ComboBox
    x:Class="Pixeval.Views.Settings.LanguageSettingsValue"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:globalization="using:System.Globalization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoSettingsPage.Models"
    xmlns:utilities="using:Pixeval.Utilities"
    x:DataType="{x:Type models:ISingleValueSettingsEntry,
                        x:TypeArguments=x:String}"
    Width="200"
    ItemsSource="{x:Static utilities:LanguageHelper.AvailableLanguages}"
    SelectedValue="{Binding Value, Mode=TwoWay}"
    SelectedValueBinding="{Binding Name}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="{x:Type globalization:CultureInfo}">
            <TextBlock Text="{Binding NativeName}" />
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
