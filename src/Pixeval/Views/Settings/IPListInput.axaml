<StackPanel
    x:Class="Pixeval.Views.Settings.IPListInput"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoSettingsPage.Models"
    xmlns:pixeval="using:Pixeval"
    xmlns:sco="using:System.Collections.ObjectModel"
    x:DataType="{x:Type models:ISingleValueSettingsEntry,
                        x:TypeArguments=sco:ObservableCollection(x:String)}"
    Spacing="8"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <TextBlock Text="{Binding Placeholder}" />
    <DockPanel HorizontalSpacing="8">
        <Button
            Width="48"
            Height="48"
            MinWidth="0"
            Padding="0"
            VerticalAlignment="Center"
            Click="AddButton_OnClick"
            Content="{markup:SymbolIcon Add}"
            DockPanel.Dock="Right"
            Theme="{StaticResource MaterialTonalButtonTheme}" />
        <controls:IPBox x:Name="IPBox" MinWidth="160" />
    </DockPanel>
    <controls:InfoBar
        x:Name="InvalidFormatInfoBar"
        IsVisible="{Binding #IPBox.IsValid, Converter={x:Static BoolConverters.Not}}"
        Mode="Error"
        Text="{I18N {x:Static pixeval:IPListInputResources.InvalidIPFormat}}" />
    <controls:InfoBar
        x:Name="DuplicatesInfoBar"
        IsVisible="False"
        Mode="Error"
        Text="{I18N {x:Static pixeval:IPListInputResources.DuplicatesWithExistingIP}}" />
    <ItemsControl ItemsSource="{Binding Value, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="{x:Type x:String}">
                <Border
                    Padding="12,4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                    <DockPanel HorizontalSpacing="12">
                        <Button
                            Width="32"
                            Height="32"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Click="RemoveButton_OnClick"
                            Content="{markup:SymbolIcon Dismiss,
                                                        FontSize=16}"
                            DockPanel.Dock="Right"
                            Theme="{StaticResource TransparentButtonStyle}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding}"
                            TextTrimming="CharacterEllipsis"
                            Theme="{StaticResource BodyTextBlockStyle}" />
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
