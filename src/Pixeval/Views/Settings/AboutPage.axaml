<views:IconContentPage
    x:Class="Pixeval.Views.Settings.AboutPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings"
    xmlns:utilities="using:Pixeval.Utilities"
    xmlns:views="using:Pixeval.Views"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Pixeval" Theme="{StaticResource TitleTextBlockStyle}" />
                <SelectableTextBlock
                    VerticalAlignment="Bottom"
                    Text="{Binding $parent[settings:AboutPage].CurrentVersionText}"
                    Theme="{StaticResource CaptionTextBlockStyle}" />

                <TextBlock
                    DockPanel.Dock="Top"
                    Text="{I18N {x:Static pixeval:AboutPageResources+AppDescriptionTextBlock.Text}}"
                    TextWrapping="Wrap" />

                <!--  Special Thanks  -->
                <TextBlock Text="{I18N {x:Static pixeval:AboutPageResources+SpecialThanksSubtitleTextBlock.Text}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{Binding $parent[settings:AboutPage].Supporters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="10" LineSpacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type settings:Supporter}">
                            <Border
                                Width="140"
                                Height="160"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Cursor="Hand"
                                Tag="{Binding ProfileUri}"
                                Tapped="SupporterCard_OnTapped">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <local:AvatarImage
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        local:Source.Cache="{Binding LocalProfilePicture}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding Nickname}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                        Text="{Binding AtName}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Dependencies  -->
                <TextBlock Text="{I18N {x:Static pixeval:AboutPageResources+DependenciesSubtitleTextBlock.Text}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Static settings:DependencyViewModel.DependencyViewModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SettingStackPanelSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type settings:DependencyViewModel}">
                            <controls:SettingsExpander
                                Description="{Binding Author}"
                                Header="{Binding Name}"
                                HeaderIcon="{markup:SymbolIcon Box}">
                                <m3:IconButton
                                    AutomationProperties.Name="{Binding Url}"
                                    Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                    Symbol="OpenInNew"
                                    Tag="{Binding Url}" />
                                <controls:SettingsExpander.Items>
                                    <controls:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Vertical">
                                        <local:MarkdownBox Markdown="{Binding License}" />
                                    </controls:SettingsCard>
                                </controls:SettingsExpander.Items>
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Open Source License  -->
                <TextBlock Text="{I18N {x:Static pixeval:AboutPageResources+OpenSourceLicenseSubtitleTextBlock.Text}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <local:MarkdownBox x:Name="LicenseTextBlock" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:IconContentPage>
