<DrawerPage
    x:Class="Pixeval.Views.Home.HomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appManagement="using:Pixeval.AppManagement"
    xmlns:capability="using:Pixeval.Views.Capability"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:home="using:Pixeval.Views.Home"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:viewModels="using:Pixeval.ViewModels.Home"
    xmlns:views="using:Pixeval.Views"
    x:DataType="{x:Type viewModels:HomePageViewModel}"
    Background="Transparent"
    BorderThickness="0"
    DrawerLayoutBehavior="Split"
    DrawerPlacement="Right"
    Header="{I18N {x:Static pixeval:MainPageResources+Tab.Home}}"
    Icon="{markup:SymbolIcon Home,
                             FontSize=16,
                             IconVariant=Color}"
    IsOpen="{Binding IsEditMode, Mode=TwoWay}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <DrawerPage.Styles>
        <!--  The home toolbar controls the editor in place of the template toggles.  -->
        <Style Selector="DrawerPage /template/ Border#PART_TopBar, DrawerPage /template/ ToggleButton#PART_CompactPaneToggle">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Border.editor-section">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>

        <Style Selector="Border.home-grid-guide-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>

        <Style Selector="TextBlock.editor-label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="NumericUpDown.integer-editor">
            <Setter Property="AllowSpin" Value="True" />
            <Setter Property="ClipValueToMinMax" Value="True" />
            <Setter Property="FormatString" Value="F0" />
            <Setter Property="Increment" Value="1" />
        </Style>

        <Style Selector="NumericUpDown.card-layout-editor">
            <Setter Property="IsEnabled" Value="{Binding HasSelectedCard}" />
            <Setter Property="Minimum" Value="1" />
        </Style>
    </DrawerPage.Styles>
    <DockPanel x:DataType="{x:Type viewModels:HomePageViewModel}" DataContext="{Binding $parent[home:HomePage].DataContext}">
        <DockPanel
            Margin="16,4"
            DockPanel.Dock="Top"
            HorizontalSpacing="8">
            <DockPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="IsEditMode" />
                    <Binding Path="!HideHomePageToolbar" Source="{x:Static views:PixevalSettings.Instance}" />
                </MultiBinding>
            </DockPanel.IsVisible>
            <Border
                Width="28"
                Height="28"
                Background="{SvgResource avares://Pixeval/Assets/logo.svg}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                DockPanel.Dock="Left" />
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Text="{x:Static appManagement:AppInfo.AppIdentifier}"
                Theme="{StaticResource SubtitleTextBlockStyle}" />
            <CommandBar
                HorizontalAlignment="Right"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <CommandBarToggleButton
                    Icon="{markup:SymbolIcon AppTitle}"
                    IsChecked="{Binding HideHomePageCardTitle, Source={x:Static views:PixevalSettings.Instance}, Mode=TwoWay}"
                    Label="{I18N {x:Static pixeval:HomePageResources+HideCardTitleButton.Label}}" />
                <CommandBarToggleButton
                    Icon="{markup:SymbolIcon WindowHeaderHorizontal}"
                    IsChecked="{Binding HideHomePageToolbar, Source={x:Static views:PixevalSettings.Instance}, Mode=TwoWay}"
                    Label="{I18N {x:Static pixeval:HomePageResources+HideToolbarButton.Label}}" />
                <CommandBarToggleButton
                    x:Name="EditButton"
                    Icon="{markup:SymbolIcon Edit}"
                    IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                    Label="{I18N {x:Static pixeval:HomePageResources+EditButton.Label}}" />
            </CommandBar>
        </DockPanel>

        <Grid Margin="16" ClipToBounds="True">
            <Grid
                x:Name="GuideGrid"
                ColumnSpacing="12"
                IsHitTestVisible="False"
                IsVisible="{Binding IsEditMode}"
                RowSpacing="12" />
            <Grid
                x:Name="HomeGrid"
                ColumnSpacing="12"
                RowSpacing="12" />
        </Grid>
    </DockPanel>

    <DrawerPage.DrawerHeader>
        <Border
            Padding="16,12"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="{I18N {x:Static pixeval:HomePageResources+EditPaneTitleTextBlock.Text}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{I18N {x:Static pixeval:HomePageResources+EditPaneDescriptionTextBlock.Text}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </DrawerPage.DrawerHeader>

    <DrawerPage.Drawer>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="16">
                <Border Classes="editor-section">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static pixeval:HomePageResources+GridSizeTitleTextBlock.Text}}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <TextBlock
                                Grid.Column="0"
                                Classes="editor-label"
                                Text="{I18N {x:Static pixeval:HomePageResources+GridColumnsTextBlock.Text}}" />
                            <NumericUpDown
                                Grid.Column="1"
                                Classes="integer-editor"
                                Maximum="{x:Static home:HomePage.MaximumGridSize}"
                                Minimum="{x:Static home:HomePage.MinimumGridSize}"
                                Value="{Binding GridColumnsValue, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="editor-label"
                                Text="{I18N {x:Static pixeval:HomePageResources+GridRowsTextBlock.Text}}" />
                            <NumericUpDown
                                Grid.Column="3"
                                Classes="integer-editor"
                                Maximum="{x:Static home:HomePage.MaximumGridSize}"
                                Minimum="{x:Static home:HomePage.MinimumGridSize}"
                                Value="{Binding GridRowsValue, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="editor-section">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static pixeval:HomePageResources+SelectedCardTitleTextBlock.Text}}" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedCardDescription}"
                            TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <TextBlock
                                Grid.Column="0"
                                Classes="editor-label"
                                Text="{I18N {x:Static pixeval:HomePageResources+PositionXTextBlock.Text}}" />
                            <NumericUpDown
                                Grid.Column="1"
                                Classes="integer-editor card-layout-editor"
                                Maximum="{Binding ColumnCount}"
                                Value="{Binding SelectedColumnValue, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="editor-label"
                                Text="{I18N {x:Static pixeval:HomePageResources+PositionYTextBlock.Text}}" />
                            <NumericUpDown
                                Grid.Column="3"
                                Classes="integer-editor card-layout-editor"
                                Maximum="{Binding RowCount}"
                                Value="{Binding SelectedRowValue, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <TextBlock
                                Grid.Column="0"
                                Classes="editor-label"
                                Text="{I18N {x:Static pixeval:HomePageResources+WidthTextBlock.Text}}" />
                            <NumericUpDown
                                Grid.Column="1"
                                Classes="integer-editor card-layout-editor"
                                Maximum="{Binding ColumnCount}"
                                Value="{Binding SelectedWidthValue, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="editor-label"
                                Text="{I18N {x:Static pixeval:HomePageResources+HeightTextBlock.Text}}" />
                            <NumericUpDown
                                Grid.Column="3"
                                Classes="integer-editor card-layout-editor"
                                Maximum="{Binding RowCount}"
                                Value="{Binding SelectedHeightValue, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{I18N {x:Static pixeval:HomePageResources+CardBackgroundTextBlock.Text}}" />
                            <ColorPicker
                                HorizontalAlignment="Stretch"
                                IsAlphaEnabled="True"
                                IsAlphaVisible="True"
                                IsColorModelVisible="False"
                                IsColorPaletteVisible="False"
                                IsComponentSliderVisible="False"
                                IsComponentTextInputVisible="False"
                                IsEnabled="{Binding HasSelectedCard}"
                                IsHexInputVisible="True"
                                Color="{Binding SelectedBackgroundColor, Mode=TwoWay}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding $parent[home:HomePage].DeleteSelectedCardCommand}"
                            IsEnabled="{Binding HasSelectedCard}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ContentControl Content="{markup:SymbolIcon Delete}" />
                                <TextBlock Text="{I18N {x:Static pixeval:HomePageResources+DeleteSelectedCardButton.Content}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Classes="editor-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceParameterTitle}" />
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SourceParameterDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ActiveParameterEditors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="{x:Type viewModels:HomeCardChoiceParameterEditorViewModel}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Header}" />
                                        <controls:SymbolComboBox
                                            HorizontalAlignment="Stretch"
                                            IconMode="False"
                                            ItemsSource="{Binding Items}"
                                            SelectedValue="{Binding Value, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate x:DataType="{x:Type viewModels:HomeCardTextParameterEditorViewModel}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Header}" />
                                        <TextBox Text="{Binding Text, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate x:DataType="{x:Type viewModels:HomeCardRankingDateParameterEditorViewModel}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Header}" />
                                        <CheckBox Content="{I18N {x:Static pixeval:HomePageResources+Source+UseSpecifiedRankingDateCheckBox.Content}}" IsChecked="{Binding UseSpecifiedDate, Mode=TwoWay}" />
                                        <CalendarDatePicker
                                            HorizontalAlignment="Stretch"
                                            DisplayDateEnd="{x:Static capability:WorkRankingPage.MaxDate}"
                                            IsEnabled="{Binding UseSpecifiedDate}"
                                            SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                            SelectedDateFormat="Short" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>

                        <Button
                            HorizontalAlignment="Stretch"
                            Classes="accent"
                            Command="{Binding $parent[home:HomePage].AddConfiguredCardCommand}"
                            IsEnabled="{Binding CanAddConfiguredCard}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ContentControl Content="{markup:SymbolIcon Add}" />
                                <TextBlock Text="{I18N {x:Static pixeval:HomePageResources+AddConfiguredCardButton.Content}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{I18N {x:Static pixeval:HomePageResources+CardLibraryTitleTextBlock.Text}}" />
                    <ItemsControl ItemsSource="{Binding CardTemplates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type home:HomeCardDefinition}">
                                <Button
                                    Padding="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Command="{Binding $parent[home:HomePage].ViewModel.SelectTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <fluent:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="20"
                                            IconVariant="Color"
                                            Symbol="{Binding Symbol}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <fluent:SymbolIcon
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="ChevronRight" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DrawerPage.Drawer>
</DrawerPage>
