<ContentPage
    x:Class="Pixeval.Views.Search.SauceNaoSearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:viewModels="using:Pixeval.ViewModels.Search"
    x:DataType="{x:Type viewModels:SauceNaoSearchPageViewModel}"
    Header="{I18N {x:Static pixeval:SearchResources+AdvancedOptions.SauceNaoTab}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <ContentPage.DataContext>
        <viewModels:SauceNaoSearchPageViewModel />
    </ContentPage.DataContext>
    <DockPanel
        Margin="12"
        IsEnabled="{Binding IsApiKeyExisted}"
        VerticalSpacing="12">
        <controls:InfoBar
            DockPanel.Dock="Top"
            IsVisible="{Binding !IsApiKeyExisted}"
            Mode="Warning"
            Text="{I18N {x:Static pixeval:SearchResources+SauceNAO.ProvideApiKey}}" />
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonGroup.Spacing}}">
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="SearchButton_OnClick"
                Content="{I18N {x:Static pixeval:SearchResources+SauceNAO.Search}}"
                IsEnabled="{Binding FileSelected}" />
            <m3:Card
                Grid.Row="1"
                MaxHeight="600"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="OpenFileButton_OnClick"
                Theme="{StaticResource ContentCardTheme}">
                <Panel Margin="20">
                    <StackPanel VerticalAlignment="Center" Spacing="20">
                        <PathIcon
                            Width="100"
                            Height="100"
                            Data="{markup:SvgPath {x:Static pixeval:SvgResources.SauceNAO}}" />
                        <TextBlock
                            m3:MaterialText.Style="{m3:Typography TitleLarge}"
                            Text="{I18N {x:Static pixeval:SearchResources+SauceNAO.ProvideImage}}"
                            TextAlignment="Center" />
                    </StackPanel>
                    <Image Source="{Binding Image}" />
                </Panel>
            </m3:Card>
            <Button
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding PasteCommand}"
                CommandParameter="{Binding $self}"
                Content="{I18N {x:Static pixeval:SearchResources+SauceNAO.PasteFromClipboard}}" />
        </Grid>
    </DockPanel>
</ContentPage>
