<UserControl
    x:Class="Pixeval.Views.Work.WorkView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Entry"
    xmlns:local="using:Pixeval.Views.Work"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views"
    xmlns:vm="using:Pixeval.ViewModels"
    x:DataType="{x:Type vm:IOperableViewViewModel}"
    x:Name="WorkViewRoot"
    DataContextChanged="StyledElement_OnDataContextChanged"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <entry:EntryView
        x:Name="EntryView"
        HasNoItem="{Binding !View.Count}"
        IsLoadingMore="{Binding #WorkListBox.(controls:IncrementalLoadingBehavior.IsLoadingMore)}">
        <local:WorkListBox
            x:Name="WorkListBox"
            controls:IncrementalLoadingBehavior.IsEnabled="True"
            controls:IncrementalLoadingBehavior.Threshold="200"
            AutoScrollToSelectedItem="False"
            ContainerClearing="ListBox_OnContainerClearing"
            ContainerPrepared="ListBox_OnContainerPrepared"
            ItemsSource="{Binding View}"
            SelectedItems="{Binding SelectedEntries}"
            SelectionMode="{Binding IsSelecting, Converter={x:Static local:WorkView.SelectionModeConverter}}"
            UseLayoutRounding="False">
            <ListBox.ContextMenu>
                <ContextMenu
                    x:DataType="{x:Type local:WorkView+SelectionMenuModel}"
                    DataContext="{Binding #WorkViewRoot.SelectionMenu, Mode=OneTime}"
                    Opening="SelectionMenu_OnOpening">
                    <MenuItem
                        Command="{Binding BookmarkCommand}"
                        ContextRequested="SelectionBookmark_OnContextRequested"
                        Header="{Binding BookmarkCount, StringFormat={I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.BookmarkWorksFormatted}}}"
                        Icon="{markup:SymbolIcon Heart}"
                        IsEnabled="{Binding !!BookmarkCount}" />
                    <MenuItem
                        Command="{Binding RemoveBookmarkCommand}"
                        Header="{Binding RemoveBookmarkCount, StringFormat={I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.RemoveBookmarksFormatted}}}"
                        Icon="{markup:SymbolIcon HeartBroken}"
                        IsEnabled="{Binding !!RemoveBookmarkCount}" />
                    <MenuItem
                        Command="{Binding AddToWatchLaterCommand}"
                        Header="{I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.AddSelectedToWatchLater}}"
                        Icon="{markup:SymbolIcon Clock}" />
                    <MenuItem
                        Command="{Binding SaveCommand}"
                        Header="{I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.SaveSelectedWorks}}"
                        Icon="{markup:SymbolIcon Save}"
                        IsVisible="{Binding CanSave}" />
                    <MenuItem
                        Command="{Binding OpenInBrowserCommand}"
                        Header="{I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.OpenSelectedWorksInBrowser}}"
                        Icon="{markup:SymbolIcon GlobeArrowUp}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding FollowCommand}"
                        Header="{Binding FollowCount, StringFormat={I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.FollowAuthorsFormatted}}}"
                        Icon="{markup:SymbolIcon PersonAdd}"
                        IsEnabled="{Binding !!FollowCount}" />
                    <MenuItem
                        Command="{Binding UnfollowCommand}"
                        Header="{Binding UnfollowCount, StringFormat={I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.UnfollowAuthorsFormatted}}}"
                        Icon="{markup:SymbolIcon PersonSubtract}"
                        IsEnabled="{Binding !!UnfollowCount}" />
                    <MenuItem
                        Command="{Binding BlockAuthorsCommand}"
                        Header="{I18N {x:Static pixeval:WorkContainerResources+SelectionMenu.BlockSelectedAuthors}}"
                        Icon="{markup:SymbolIcon PersonProhibited}"
                        IsEnabled="{Binding CanBlockAuthors}" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.Styles>
                <controls:ItemsViewListBoxStyles />
            </ListBox.Styles>
            <ListBox.DataTemplates>
                <DataTemplate x:DataType="{x:Type vm:NovelItemViewModel}">
                    <local:NovelItem
                        RequestAddToBookmark="WorkItem_OnRequestAddToBookmark"
                        RequestBlockAuthor="WorkItem_OnRequestBlockAuthor"
                        RequestOpenUserInfoPage="WorkItem_OnRequestOpenUserInfoPage" />
                </DataTemplate>
                <DataTemplate x:DataType="{x:Type vm:IllustrationItemViewModel}">
                    <local:IllustrationItem
                        RequestAddToBookmark="WorkItem_OnRequestAddToBookmark"
                        RequestBlockAuthor="WorkItem_OnRequestBlockAuthor"
                        RequestOpenUserInfoPage="WorkItem_OnRequestOpenUserInfoPage" />
                </DataTemplate>
            </ListBox.DataTemplates>
        </local:WorkListBox>
    </entry:EntryView>
    <UserControl.Styles>
        <Style Selector="local|WorkView:linedFlow ListBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel
                            ItemHeight="{x:Static views:PixevalSettings.IllustrationLinedFlowItemHeight}"
                            ItemSpacing="5"
                            ItemsAlignment="Stretch"
                            LineSpacing="5" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="local|WorkView:verticalStack ListBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingStackPanel Orientation="Vertical" Spacing="5" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="local|WorkView:grid ListBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingAdaptiveGrid
                            ItemSize="{x:Static views:PixevalSettings.IllustrationGridItemSize}"
                            ItemSpacing="5"
                            ItemsAlignment="Stretch"
                            LineSize="{x:Static views:PixevalSettings.IllustrationGridLineSize}"
                            LineSpacing="5" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="local|WorkView:novel ListBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingAdaptiveGrid
                            ItemSize="350"
                            ItemSpacing="5"
                            ItemsAlignment="Stretch"
                            LineSize="200"
                            LineSpacing="5" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="local|WorkView:masonry ListBox">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingMasonryPanel
                            ColumnSpacing="5"
                            ColumnWidth="{x:Static views:PixevalSettings.IllustrationMasonryColumnWidth}"
                            RowSpacing="5" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>
</UserControl>
