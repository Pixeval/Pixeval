<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:local="using:Pixeval.Controls">

    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="10">
            <local:SymbolComboBox />
            <local:SymbolComboBox IconMode="False" />
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type local:SymbolComboBox}" TargetType="{x:Type local:SymbolComboBox}">
        <!--  Toolbar selectors keep Material's field and popup without its form-sized minimum width.  -->
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,8" />
        <Style Selector="^:text">
            <Setter Property="MinWidth" Value="160" />
        </Style>
        <Setter Property="IconItemTemplate">
            <Setter.Value>
                <!--  Icon 模式 - 下拉项：左侧 SymbolIcon + 右侧 Description  -->
                <DataTemplate x:DataType="{x:Type local:SymbolComboBoxItem}">
                    <local:IconText Symbol="{Binding Symbol}" Text="{Binding Description}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="IconSelectionBoxTemplate">
            <Setter.Value>
                <!--  Icon 模式 - 收起状态：只显示 SymbolIcon  -->
                <DataTemplate x:DataType="{x:Type local:SymbolComboBoxItem}">
                    <fluent:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Symbol="{Binding Symbol}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TextItemTemplate">
            <Setter.Value>
                <!--  Text 模式 - 下拉项 & 收起状态：只显示 Description  -->
                <DataTemplate x:DataType="{x:Type local:SymbolComboBoxItem}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SymbolComboBox}">
                    <ComboBox
                        x:DataType="local:SymbolComboBoxItem"
                        Name="PART_ComboBox"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                        ItemsSource="{TemplateBinding ItemsSource}"
                        SelectedValue="{TemplateBinding SelectedValue,
                                                        Mode=TwoWay}"
                        SelectedValueBinding="{Binding Value}">
                        <ComboBox.Styles>
                            <!--  Use the public selection template, not a theme-specific presenter.  -->
                            <Style Selector="ComboBox">
                                <Setter Property="ItemTemplate" Value="{Binding $parent[local:SymbolComboBox].IconItemTemplate}" />
                                <Setter Property="SelectionBoxItemTemplate" Value="{Binding $parent[local:SymbolComboBox].IconSelectionBoxTemplate}" />
                            </Style>
                            <!--  Text 模式：切换下拉项模板  -->
                            <Style Selector="ComboBox.text">
                                <Setter Property="ItemTemplate" Value="{Binding $parent[local:SymbolComboBox].TextItemTemplate}" />
                                <Setter Property="SelectionBoxItemTemplate" Value="{Binding $parent[local:SymbolComboBox].TextItemTemplate}" />
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
